<Page x:Class="KassensystemPOS.Rechnungen"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KassensystemPOS"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Rechnungen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid Grid.Row="0"
            ItemsSource="{Binding}"
            AutoGenerateColumns="False"
            x:Name="dataGrid" Language="DE" ItemStringFormat="">
            <DataGrid.Columns>
                <DataGridTextColumn Header="RechnugsID" Binding="{Binding RechnungsID,StringFormat=N0}" />
                <DataGridTextColumn Header="Nettobetrag"  Binding="{Binding NettoGesamtBetrag,StringFormat=N2}"/>
                <DataGridTextColumn Header="Steuer"  Binding="{Binding Steuer,StringFormat=N2}"/>
                <DataGridTextColumn Header="Bruttobetrag"  Binding="{Binding BruttoBetrag,StringFormat=N2}"/>
                <DataGridTextColumn Header="Zahlart"  Binding="{Binding Zahlart}"/>
                <DataGridTextColumn Header="Storno von"  Binding="{Binding StornoVon}"/>
                <DataGridTextColumn Header="Datum/Uhrzeit"  Binding="{Binding RechnungsDatum,StringFormat=dd.MM.yyyy - HH:mm:ss}"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="1" LastChildFill="True" Margin="4">
            <Label DockPanel.Dock="Left" Content="Rechnungsnummer:" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Stornieren" Width="150" Click="btn_Storno_Click" Background="#C0392B"/>
            <TextBox x:Name="textBox" TextChanged="textBox_TextChanged"/>
        </DockPanel>
    </Grid>
</Page>
