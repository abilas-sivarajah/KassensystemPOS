<Page x:Class="KassensystemPOS.Abrechnung"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:KassensystemPOS"
      mc:Ignorable="d"
      d:DesignHeight="500" d:DesignWidth="850"
      Title="Abrechnung" Loaded="Page_Loaded">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Offene Rechnungen ===== -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16" Margin="0,0,10,0">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.12" BlurRadius="14" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <DockPanel>
                <Label DockPanel.Dock="Top" Content="Unabgerechnete Rechnungen" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" Padding="0"/>
                <ListView IsEnabled="False" Language="DE" x:Name="lv_Rechnungen" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="120" DisplayMemberBinding="{Binding RechnungsID}" Header="RechnungsID"/>
                            <GridViewColumn Width="140" DisplayMemberBinding="{Binding BruttoBetrag}" Header="Bruttobetrag"/>
                            <GridViewColumn Width="200" DisplayMemberBinding="{Binding Datum}" Header="Datum/Uhrzeit"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <!-- ===== Zusammenfassung + Abrechnen ===== -->
        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="24" Margin="10,0,0,0">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.12" BlurRadius="14" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Content="Abrechnen" FontSize="28" Height="76" Click="Abbrechnen_Click"/>
                <StackPanel>
                    <Label Content="Tagesabschluss (Z-Bon)" FontSize="22" FontWeight="Bold" Margin="0,0,0,16" Padding="0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Label Content="Umsatz: " FontSize="30" FontWeight="Bold"/>
                        <Label x:Name="lbl_Umsatz" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="davon Bar:"   FontSize="18" Margin="0,2,12,2"/>
                        <Label Grid.Row="0" Grid.Column="1" x:Name="lbl_Bar"   FontSize="18" Margin="0,2"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="davon Karte:" FontSize="18" Margin="0,2,12,2"/>
                        <Label Grid.Row="1" Grid.Column="1" x:Name="lbl_Karte" FontSize="18" Margin="0,2"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="Verkäufe:"    FontSize="18" Margin="0,2,12,2"/>
                        <Label Grid.Row="2" Grid.Column="1" x:Name="lbl_Anzahl" FontSize="18" Margin="0,2"/>

                        <Label Grid.Row="3" Grid.Column="0" Content="Stornos:"     FontSize="18" Margin="0,2,12,2"/>
                        <Label Grid.Row="3" Grid.Column="1" x:Name="lbl_Storno" FontSize="18" Margin="0,2"/>

                        <Label Grid.Row="4" Grid.Column="0" Content="Datum:"       FontSize="18" Margin="0,2,12,2"/>
                        <Label Grid.Row="4" Grid.Column="1" x:Name="lbl_Datum"  FontSize="18" Margin="0,2"/>
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Page>
