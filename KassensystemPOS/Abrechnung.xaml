<Page x:Class="KassensystemPOS.Abrechnung"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KassensystemPOS"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Abrechnung" Loaded="Page_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="1.5*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="5*"></RowDefinition>
            <RowDefinition Height="5*"></RowDefinition>
        </Grid.RowDefinitions>

        <Label Grid.Column="0" Grid.Row="0">Unabgerechnete Rechnugen</Label>
        <Label Grid.Column="1" Grid.Row="0"></Label>

        <!--<Label HorizontalAlignment="Center" FontSize="50" Content="Umsatz:"/>
        <Label HorizontalAlignment="Right" FontSize="50" Language="DE" Name="lbl_Umsatzbetrag"></Label>-->



        <ListView IsEnabled="False" Language="DE" Grid.Column="0" Grid.Row="1" Grid.RowSpan="2" x:Name="lv_Rechnungen">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="auto" DisplayMemberBinding="{Binding RechnungsID}" Header="RechnungsID" ></GridViewColumn>
                    <GridViewColumn Width="auto" DisplayMemberBinding="{Binding BruttoBetrag}" Header="Bruttobetrag"></GridViewColumn>
                    <GridViewColumn Width="auto" DisplayMemberBinding="{Binding Datum}" Header="Datum/Uhrzeit"></GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <Button Grid.Column="1" Grid.Row="2" Content="Abrechnen" FontSize="50" Click="Abbrechnen_Click"/>
        <Label FontSize="40" Language="DE" x:Name="lbl_Datum" Grid.Column="1" HorizontalAlignment="Center" Margin="229,112,0,0" Grid.Row="1" VerticalAlignment="Top" Height="71" Width="228"/>
        <Label x:Name="label_Copy1" Content="Umsatz:" FontSize="50" HorizontalAlignment="Left" VerticalAlignment="Top" Height="73" Width="236" Grid.Column="1" Margin="39,34,0,0" Grid.Row="1" />

        <Label FontSize="50" x:Name="lbl_Umsatz"  Grid.Column="1" HorizontalAlignment="Left" Margin="302,34,0,0" Grid.Row="1" VerticalAlignment="Top" Height="73" Width="155"/>
        <Label x:Name="label" Content="Datum:" FontSize="40" Grid.Column="1" HorizontalAlignment="Left" Margin="39,112,0,0" Grid.Row="1" VerticalAlignment="Top" Height="71" Width="166"/>



    </Grid>
</Page>
