<Page x:Class="KassensystemPOS.UnternehmensDatenPflege"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KassensystemPOS"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UnternehmensDatenPflege" Loaded="Page_Loaded">

    <Grid>
        <TextBox x:Name="txt_name" HorizontalAlignment="Left" Height="22" Margin="204,58,0,0" TextWrapping="Wrap" Text="{Binding Name}" VerticalAlignment="Top" Width="120"/>
        <TextBox  Name="txt_straße" HorizontalAlignment="Left" Height="22" Margin="204,105,0,0" TextWrapping="Wrap" Text="{Binding Strasse}" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="txt_hausnr" HorizontalAlignment="Left" Height="22" Margin="204,154,0,0" TextWrapping="Wrap" Text="{Binding Hausnummer}" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="txt_plz" HorizontalAlignment="Left" Height="22" Margin="204,206,0,0" TextWrapping="Wrap" Text="{Binding  PLZ}" VerticalAlignment="Top" Width="120"></TextBox>
        <TextBox x:Name="txt_ort" HorizontalAlignment="Left" Height="22" Margin="204,256,0,0" TextWrapping="Wrap" Text="{Binding  Ort}" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="txt_tel" HorizontalAlignment="Left" Height="22" Margin="204,301,0,0" TextWrapping="Wrap" Text="{Binding  Tel}" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="txt_steuernr" HorizontalAlignment="Left" Height="22" Margin="204,343,0,0" TextWrapping="Wrap" Text="{Binding Steuernummer}" VerticalAlignment="Top" Width="120"/>

        <Label x:Name="label" Content="Unternehmensname:" HorizontalAlignment="Left" Margin="54,58,0,0" VerticalAlignment="Top"/>
        <Label x:Name="label_Copy" Content="Telefon:" HorizontalAlignment="Left" Margin="54,301,0,0" VerticalAlignment="Top"/>
        <Label x:Name="label_Copy1" Content="Ort:" HorizontalAlignment="Left" Margin="54,260,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.829,2.115"/>
        <Label x:Name="label_Copy2" Content="PLZ:" HorizontalAlignment="Left" Margin="54,206,0,0" VerticalAlignment="Top"/>
        <Label x:Name="label_Copy3" Content="Hausnummer:" HorizontalAlignment="Left" Margin="54,154,0,0" VerticalAlignment="Top"/>
        <Label x:Name="label_Copy4" Content="Straße:" HorizontalAlignment="Left" Margin="54,105,0,0" VerticalAlignment="Top"/>
        <Label x:Name="label_Copy5" Content="Steuernummer:" HorizontalAlignment="Left" Margin="54,343,0,0" VerticalAlignment="Top"/>
        
        <Button x:Name="button" Content="Daten Speichern" HorizontalAlignment="Left" Margin="462,56,0,0" VerticalAlignment="Top" Width="180" Height="71" Click="button_Click"/>
        <Button x:Name="button_add" Content="Daten Anlegen" HorizontalAlignment="Left" Margin="462,172,0,0" VerticalAlignment="Top" Width="180" Height="71" Click="button_add_Click"/>
        <Button x:Name="button_add_Copy" Content="Daten Löschen" HorizontalAlignment="Left" Margin="462,298,0,0" VerticalAlignment="Top" Width="180" Height="71" Click="button_del_Click"/>

    </Grid>
</Page>
