<Page x:Class="KassensystemPOS.UnternehmensDatenPflege"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:KassensystemPOS"
      mc:Ignorable="d"
      d:DesignHeight="500" d:DesignWidth="850"
      Title="UnternehmensDatenPflege" Loaded="Page_Loaded">

    <Grid>
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                Margin="30" Padding="32" VerticalAlignment="Top">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="18" ShadowDepth="3" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ===== Formular ===== -->
                <StackPanel Grid.Column="0" Margin="0,0,40,0">
                    <Label Content="Unternehmensdaten" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Padding="0"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label   Grid.Row="0" Grid.Column="0" Content="Unternehmensname:" Margin="0,6,16,6"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txt_name"     Text="{Binding Name}"/>

                        <Label   Grid.Row="1" Grid.Column="0" Content="Straße:" Margin="0,6,16,6"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txt_straße"  Text="{Binding Strasse}"/>

                        <Label   Grid.Row="2" Grid.Column="0" Content="Hausnummer:" Margin="0,6,16,6"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txt_hausnr"  Text="{Binding Hausnummer}"/>

                        <Label   Grid.Row="3" Grid.Column="0" Content="PLZ:" Margin="0,6,16,6"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="txt_plz"     Text="{Binding PLZ}"/>

                        <Label   Grid.Row="4" Grid.Column="0" Content="Ort:" Margin="0,6,16,6"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="txt_ort"     Text="{Binding Ort}"/>

                        <Label   Grid.Row="5" Grid.Column="0" Content="Telefon:" Margin="0,6,16,6"/>
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="txt_tel"     Text="{Binding Tel}"/>

                        <Label   Grid.Row="6" Grid.Column="0" Content="Steuernummer:" Margin="0,6,16,6"/>
                        <TextBox Grid.Row="6" Grid.Column="1" x:Name="txt_steuernr" Text="{Binding Steuernummer}"/>
                    </Grid>
                </StackPanel>

                <!-- ===== Buttons ===== -->
                <StackPanel Grid.Column="1" VerticalAlignment="Top" Width="190" Margin="0,52,0,0">
                    <Button x:Name="button"          Content="Daten Speichern" Height="64" Margin="0,0,0,16" Click="button_Click"/>
                    <Button x:Name="button_add"      Content="Daten Anlegen"   Height="64" Margin="0,0,0,16" Click="button_add_Click"/>
                    <Button x:Name="button_add_Copy" Content="Daten Löschen"   Height="64" Margin="0,0,0,16" Click="button_del_Click"
                            Background="#C0392B"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
