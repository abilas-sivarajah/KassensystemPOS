<Page x:Class="KassensystemPOS.Artikelverwaltung"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KassensystemPOS"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="Artikelverwaltung">

    <Grid Name="parentGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>


        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <!--<RowDefinition/>
            <RowDefinition/>-->

        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0" Grid.Row="0">
            <Label FontFamily="Arial" FontSize="30" Margin="5">Artikelsuche</Label>
            <ScrollViewer Height="350">
                <ListBox x:Name="listBox" 
      ItemsSource="{Binding}"
      IsSynchronizedWithCurrentItem="True"
      DisplayMemberPath="Artikelbez"
   />
            </ScrollViewer>

            <!--<Button Height="50" FontSize="30" FontWeight="Bold" Name="Update_cb" Margin="5,60" Click="Update_cb_Click">Liste Aktualisieren</Button>-->
        </StackPanel>


        <GroupBox FontSize="20" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2">
            <StackPanel>
                <Label FontFamily="Arial" FontSize="20" Margin="5">Artikelnummer</Label>
                <TextBox FontSize="20" Name="tb_artikelnr" Text="{Binding Artikelnr}" Margin="5" Height="auto"></TextBox>

                <Label FontFamily="Arial" FontSize="20" Margin="5">Artikelname</Label>
                <TextBox FontSize="20"  Margin="5" Text="{Binding Artikelbez}"  Name="tb_Artikelbez" Height="auto"></TextBox>

                <Label FontFamily="Arial" FontSize="20" Margin="5">Nettopreis</Label>
                <TextBox FontSize="20" Name="tb_artikelpreis" Text="{Binding Nettopreis , StringFormat=0.00}" Language="DE" Margin="5" Height="auto"></TextBox>

                <Label FontFamily="Arial" FontSize="20" Margin="5">Steuersatz</Label>
                <StackPanel Orientation="Horizontal">
                    <TextBox Width="50" Name="tb_steuersatz" FontSize="20" Text="{Binding Steuersatz}" Margin="5,2,5,2" Height="auto"></TextBox>
                    <Label>%</Label>
                </StackPanel>

                <Label FontFamily="Arial" FontSize="20" Margin="5">Kategorie</Label>
                <TextBox FontSize="20" IsEnabled="False" Text="{Binding Kategorie}" Margin="5,2,5,2" Height="auto"></TextBox>
            
            </StackPanel>
        </GroupBox>



        <GroupBox  Grid.Column="2"   FontSize="30" Grid.Row="0" Grid.RowSpan="2" Header="Artikel-Funktionen ">
            <StackPanel>
                <Button x:Name="btn_add" Content="Hinzufügen" FontSize="25" Click="btn_add_Click" Margin="10,20,10,45"/>
                <Button x:Name="btn_update" FontSize="25" Content="Änderung Speichern" Click="btn_update_Click" Margin="10,20,10,50"/>
                <Button x:Name="btn_Delete" Content="Löschen" FontSize="25" Click="btn_Delete_Click" Margin="10,20,10,20"/>
            </StackPanel>
        </GroupBox>




    </Grid>

</Page>
