<Page x:Class="KassensystemPOS.Artikelverwaltung"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:KassensystemPOS"
      mc:Ignorable="d"
      d:DesignHeight="500" d:DesignWidth="850"
      Title="Artikelverwaltung">

    <Grid Name="parentGrid" Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1.3*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Artikelsuche ===== -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16" Margin="0,0,10,0">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.12" BlurRadius="14" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <DockPanel>
                <Label DockPanel.Dock="Top" Content="Artikelsuche" FontSize="22" FontWeight="Bold" Margin="0,0,0,10" Padding="0"/>
                <ListBox x:Name="listBox"
                         ItemsSource="{Binding}"
                         IsSynchronizedWithCurrentItem="True"
                         DisplayMemberPath="Artikelbez"
                         FontSize="15" BorderThickness="0"/>
            </DockPanel>
        </Border>

        <!-- ===== Artikeldetails ===== -->
        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20" Margin="10,0,10,0">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.12" BlurRadius="14" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <StackPanel>
                <Label Content="Artikeldetails" FontSize="22" FontWeight="Bold" Margin="0,0,0,14" Padding="0"/>

                <Label Content="Artikelnummer" Margin="0,4,0,0"/>
                <TextBox Name="tb_artikelnr" Text="{Binding Artikelnr}"/>

                <Label Content="Artikelname" Margin="0,4,0,0"/>
                <TextBox Name="tb_Artikelbez" Text="{Binding Artikelbez}"/>

                <Label Content="Nettopreis" Margin="0,4,0,0"/>
                <TextBox Name="tb_artikelpreis" Text="{Binding Nettopreis, StringFormat=0.00}" Language="DE"/>

                <Label Content="Steuersatz (%)" Margin="0,4,0,0"/>
                <TextBox Name="tb_steuersatz" Text="{Binding Steuersatz}"/>

                <Label Content="Kategorie" Margin="0,4,0,0"/>
                <TextBox IsEnabled="False" Text="{Binding Kategorie}"/>
            </StackPanel>
        </Border>

        <!-- ===== Funktionen ===== -->
        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20" Margin="10,0,0,0">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.12" BlurRadius="14" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <StackPanel>
                <Label Content="Funktionen" FontSize="22" FontWeight="Bold" Margin="0,0,0,14" Padding="0"/>
                <Button x:Name="btn_add"    Content="Hinzufügen"        Height="60" Margin="0,0,0,14" Click="btn_add_Click"/>
                <Button x:Name="btn_update" Content="Änderung speichern" Height="60" Margin="0,0,0,14" Click="btn_update_Click"/>
                <Button x:Name="btn_Delete" Content="Löschen"           Height="60" Margin="0,0,0,14" Click="btn_Delete_Click" Background="#C0392B"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
