<Window x:Class="KassensystemPOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KassensystemPOS"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="900">
 
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Menu Grid.Row="0">
            <MenuItem Header="Kasse">
                <MenuItem Header="POS" Click="POS_MenuItem_Click"></MenuItem>
                <MenuItem Header="Verschiedene Layouts">
                    <MenuItem Header="Layout 1" Click="MenuItem_Click_1"></MenuItem>
                    <MenuItem Header="Layout 2" Click="MenuItem_Click_2"></MenuItem>
                    <MenuItem Header="Layout 3" Click="MenuItem_Click_3"></MenuItem>
                    <MenuItem Header="Layout 4" Click="MenuItem_Click_4"></MenuItem>
                </MenuItem>
                <MenuItem Header="Alle Rechnungen" Click="AlleRechnungen"></MenuItem>
                <MenuItem Header="Abrechnung" Click="Abrechnung"></MenuItem>
            </MenuItem>
            <MenuItem Header="Artikelverwaltung" Click="MenuItem_Click"></MenuItem>
            <MenuItem Header="Unternehmensdaten" Click="unternehmn_click"></MenuItem>
            
        </Menu>

        <Frame Grid.Row="1" NavigationUIVisibility="Hidden" Name="frame"/>
        
        

    </Grid>
</Window>
