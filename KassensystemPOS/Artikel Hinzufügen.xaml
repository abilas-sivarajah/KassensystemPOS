<Window x:Class="KassensystemPOS.Artikel_Hinzufügen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KassensystemPOS"
        mc:Ignorable="d"
        Title="Artikel Hinzufügen" Height="430" Width="460"
        WindowStartupLocation="CenterScreen">

    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Margin="18" Padding="24">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="16" ShadowDepth="2" Direction="270"/>
        </Border.Effect>
        <StackPanel>
            <Label Content="Neuen Artikel anlegen" FontSize="22" FontWeight="Bold" Margin="0,0,0,16" Padding="0"/>

            <Label Content="Artikelnummer" Margin="0,4,0,0"/>
            <TextBox Name="tb_Artikelnummer"/>

            <Label Content="Artikelbezeichnung" Margin="0,4,0,0"/>
            <TextBox Name="tb_Artikelbez"/>

            <Label Content="Nettopreis" Margin="0,4,0,0"/>
            <TextBox Name="tb_Artikelpreis" Language="DE"/>

            <Label Content="Steuersatz (%)" Margin="0,4,0,0"/>
            <TextBox Name="tb_Steuersatz"/>

            <Label Content="Kategorie" Margin="0,4,0,0"/>
            <ComboBox Name="cb_kategorie" DisplayMemberPath="Kategoriename" SelectedValuePath="Kategorie_Nr"/>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Abbrechen" Click="Button_Click" Background="#7F8C8D"/>
                <Button Grid.Column="1" Content="Hinzufügen" Click="Artikel_Add"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
